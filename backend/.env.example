# Copiez ce fichier en .env et renseignez les valeurs

PORT=5000
NODE_ENV=development

# Chaîne de connexion MongoDB (Atlas ou local)
MONGODB_URI=

# Secret de signature des JWT (longue chaîne aléatoire, ex: `openssl rand -hex 48`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origine(s) autorisée(s) pour le frontend, séparées par des virgules
CLIENT_URL=http://localhost:5173
