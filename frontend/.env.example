# Copiez ce fichier en .env et renseignez les valeurs

# URL de l'API. En dev, laissez /api (proxy Vite vers le backend).
# En production : URL complète du backend, ex. https://linkpulse-api.onrender.com/api
VITE_API_URL=/api

# (dev) Cible du proxy Vite
VITE_PROXY_TARGET=http://localhost:5000

# Origine publique affichée dans les liens partagés (ex. https://linkpulse.io).
# Si vide, l'origine courante du navigateur est utilisée.
VITE_PUBLIC_URL=
